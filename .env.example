VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Razorpay — test mode (active during development)
VITE_RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Razorpay — live mode (uncomment for production; comment out test vars above)
# VITE_RAZORPAY_KEY_ID=rzp_live_your_live_key_id
# RAZORPAY_KEY_SECRET=your_live_key_secret

# LiveKit — video classes (https://cloud.livekit.io)
# Use LIVEKIT_URL and/or VITE_LIVEKIT_URL (same wss URL)
LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
